# Backend Environment Variables
# Copy file ini ke .env dan isi sesuai kebutuhan

# Path ke video source
# File: assets/test_video.mp4
# RTSP: rtsp://user:pass@192.168.1.1:554/stream
VIDEO_SOURCE=assets/test_video.mp4

# Path ke Firebase service account key
FIREBASE_KEY_PATH=firebase-key.json

# Public URL untuk FCM image notification (gunakan ngrok saat development)
# ngrok http 8000 → copy URL-nya ke sini
PUBLIC_URL=http://localhost:8000

# FCM test token (opsional, untuk testing tanpa frontend)
# Dapatkan dari browser console setelah setup FCM di frontend
FCM_TEST_TOKEN=

# YOLOv8 device: cpu | cuda | mps
YOLO_DEVICE=cpu
